# OPTIONAL. The app works without a .env file. Copy to ".env" only if you need one of these.
# No passwords or tokens are ever stored here: sign-in happens in the browser window the app opens.

# Optional overrides for the report links (normally pasted on the Connect tab instead).
ISC_OPP_REPORT_URL=

# Use a different account list (JSON, same format as industry_accounts_gainsight_resolved.json).
ACCOUNTS_FILE=

# Web port for the app (default 8765).
APP_PORT=8765

# Full path to your browser if the app cannot find it.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_PATH=
